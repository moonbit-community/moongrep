rule(
  name: "embed",
  command: "moon runwasm moonbit-community/embed $input -o $output",
)

dev_build(rule: "embed", input: "catch_all.yaml", output: "catch_all.mbt")

dev_build(
  rule: "embed",
  input: "inspect_boolean.yaml",
  output: "inspect_boolean.mbt",
)

dev_build(
  rule: "embed",
  input: "inspect_number.yaml",
  output: "inspect_number.mbt",
)

dev_build(rule: "embed", input: "match_option.yaml", output: "match_option.mbt")

dev_build(
  rule: "embed",
  input: "unnecessary_else.yaml",
  output: "unnecessary_else.mbt",
)

dev_build(
  rule: "embed",
  input: "simplifiable_assignment.yaml",
  output: "simplifiable_assignment.mbt",
)

dev_build(
  rule: "embed",
  input: "cstyle_forward_simple_forloop.yaml",
  output: "cstyle_forward_simple_forloop.mbt",
)

dev_build(
  rule: "embed",
  input: "cstyle_backward_simple_forloop.yaml",
  output: "cstyle_backward_simple_forloop.mbt",
)

dev_build(
  rule: "embed",
  input: "cstyle_forward_array_iteration.yaml",
  output: "cstyle_forward_array_iteration.mbt",
)

dev_build(
  rule: "embed",
  input: "cstyle_backward_array_iteration.yaml",
  output: "cstyle_backward_array_iteration.mbt",
)
