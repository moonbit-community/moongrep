---
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/stdio",
  "moonbitlang/core/env",
}
---

///|
/// Save stdin to a file in E2E_TEMP without writing to stdout.
async fn main {
  guard @env.args() is [_, name] else { fail("usage: save.mbtx <name>") }
  guard @env.get_env_var("E2E_TEMP") is Some(directory) && !directory.is_empty() else {
    fail("E2E_TEMP must name an existing temporary directory")
  }
  @fs.write_binary(
    "\{directory}/\{name}",
    @stdio.stdin.read_all(),
    create_mode=CreateOrTruncate,
  )
}
